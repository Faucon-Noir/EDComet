{
	"compilerOptions": {
		"lib": ["es6"],
		"target": "es6",
		"module": "commonjs",
		"outDir": "./build",
		"rootDir": "./src",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node", "jest"],
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true
	},

	"include": ["src"]
}
