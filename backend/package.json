		"express": "^5.1.0",
		"routing-controllers": "^0.11.3"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"nodemon": "^3.1.10",
		"swagger-ui-express": "^5.0.1",
		"ts-node": "^10.9.2",
		"tsoa": "^6.6.0",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2"
	}
