{
	"name": "ed-comet-backend",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "nodemon",
		"open-index": "open-cli ./coverage/lcov-report/index.html",
		"test": "jest ./src/tests/Index.test.ts --runInBand --detectOpenHandles --coverage || pnpm run open-index",
		"tsoa:gen": "tsx ./src/scripts/preTsoaGen.ts && tsoa spec && echo ✅ tsoa spec generated && tsoa routes && echo ✅ tsoa routes generated && pnpm --dir ../frontend run client:gen",
		"gen:types": "tsx ./src/scripts/generateJixxedTypes.ts"
	},
	"dependencies": {
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.4",
		"cors": "^2.8.6",
		"dotenv": "^17.3.1",
		"ed-shared": "workspace:*",
		"express": "^5.2.1",
		"routing-controllers": "^0.11.3"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.12.0",
		"@types/swagger-ui-express": "^4.1.8",
		"nodemon": "^3.1.14",
		"swagger-ui-express": "^5.0.1",
		"tsoa": "^6.6.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
