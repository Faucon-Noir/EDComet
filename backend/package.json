		"tsoa:gen": "tsx ./src/scripts/preTsoaGen.ts && tsoa spec-and-routes"
	},
	"dependencies": {
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cors": "^2.8.5",
