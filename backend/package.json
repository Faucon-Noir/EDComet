{
	"name": "ed-comet-backend",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "nodemon",
		"open-index": "open-cli ./coverage/lcov-report/index.html",
		"open:test-report": "open-cli ./coverage/jest-report.html",
		"test": "jest --config ./jest.config.cjs --runInBand --detectOpenHandles --coverage",
		"posttest": "tsx ./src/scripts/postJestReport.ts",
		"test:html": "pnpm run test && pnpm run open:test-report",
		"test:watch": "jest --config ./jest.config.cjs --watch",
		"tsoa:gen": "tsx ./src/scripts/preTsoaGen.ts && tsoa spec && echo ✅ tsoa spec generated && tsoa routes && echo ✅ tsoa routes generated && pnpm --dir ../frontend run client:gen",
		"gen:types": "tsx ./src/scripts/generateJixxedTypes.ts"
	},
	"dependencies": {
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.4",
		"cors": "^2.8.6",
		"dotenv": "^17.3.1",
		"ed-shared": "workspace:*",
		"express": "^5.2.1",
		"routing-controllers": "^0.11.3"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.12.0",
		"@types/supertest": "^6.0.3",
		"@types/swagger-ui-express": "^4.1.8",
		"jest": "^30.2.0",
		"jest-html-reporter": "^4.3.0",
		"nodemon": "^3.1.14",
		"open-cli": "^8.0.0",
		"supertest": "^7.1.3",
		"swagger-ui-express": "^5.0.1",
		"ts-jest": "^29.4.1",
		"tsoa": "^6.6.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
