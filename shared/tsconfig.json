{
	"compilerOptions": {
		"target": "es2016",
		"lib": [
			"es2016"
		],
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": ".",
		"declaration": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true,
		"strict": true
	},
	"include": [
		"index.ts",
		"types/**/*",
		"helper/**/*"
	]
}