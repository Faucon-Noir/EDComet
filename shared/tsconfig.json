{
	"compilerOptions": {
		"target": "es6",
		"lib": ["es6"],
		"module": "commonjs",
		"outDir": "./dist",
		"rootDir": ".",
		"declaration": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true,
		"strict": true
	},
	"include": ["index.ts", "types/**/*", "helper/**/*"]
}