{
	"name": "ed-comet",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint . --ext .ts,.tsx",
		"test": "vitest run",
		"test:report": "vitest run --config vitest.html.config.ts",
		"open:test-report": "vite preview --outDir test-report --open",
		"test:html": "pnpm run test:report && pnpm run open:test-report",
		"format": "prettier --write .",
		"client:gen": "openapi-generator-cli generate -i ../backend/src/swagger.json -g typescript-axios -o ./src/api > .log 2>&1 && echo ✅ Client Api generated"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/material": "^9.0.0",
		"axios": "^1.19.0",
		"ed-shared": "workspace:*",
		"i18next": "^24.2.3",
		"i18next-http-backend": "^3.0.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^15.7.4",
		"react-router-dom": "^7.13.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@openapitools/openapi-generator-cli": "^2.31.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.12.0",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/ui": "2.1.9",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^15.15.0",
		"jsdom": "^25.0.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.2",
		"vite": "^5.4.21",
		"vitest": "^2.1.9"
	}
}
